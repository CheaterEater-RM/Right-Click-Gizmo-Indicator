# =========================
# RimWorld Mod .gitignore
# =========================

# Machine-specific game paths
RimWorld.Paths.props

# Visual Studio
.vs/
*.user
*.suo
*.cache
*.rsuser

# Build artifacts
[Oo]bj/
[Bb]in/
*.pdb

# Debug symbols that land in the output folder
1.6/Assemblies/*.pdb

# NuGet
*.nuget.props
*.nuget.targets
*.nuget.dgspec.json
*.nuget.cache
project.assets.json
project.lock.json

# Rider
.idea/

# OS files
Thumbs.db
.DS_Store

# Build logs
*.binlog

# RimWorld / Harmony debug logs
harmony.log.txt
Player.log

# Claude / agent scratch
.claude/

# Agent instruction files
CLAUDE.md
AGENTS.md

# research and design docs
docs/
